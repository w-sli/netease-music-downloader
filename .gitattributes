# 统一以 LF 存储文本，避免在 Windows 侧编辑后产生整文件差异
* text=auto

*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.json text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.txt text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary

# 运行环境（双系统不要共用 .venv：Windows 是 Scripts/，Linux 是 bin/）
.venv/
.venv-*/
venv/
env/
node_modules/

# Python 缓存与测试产物
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/
.mypy_cache/

# 运行期产物
output/
*.log
.write-*
.shiyin-*

# 用户数据：会话（含账号 Cookie）、设置与下载队列
session.json
settings.json
downloads.json
# 从界面导出的下载报告
shiyin-downloads*.json

# 媒体文件：避免误提交下载到的音乐与歌词
*.mp3
*.flac
*.m4a
*.aac
*.ogg
*.opus
*.wav
*.lrc
*.ttml

# 编辑器与系统
.idea/
.vscode/
*.swp
*.orig
*.rej
.DS_Store
Thumbs.db

# 环境变量
.env
.env.*

# 数据库
*.db
*.sqlite*
